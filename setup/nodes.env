# The demo fleet: one line per VM.  Sourced after roles.env.
#
#   name       role  ip                 extra (role-specific key=value pairs)
#
# - the single `edge` node MUST use ${EDGE_IP} (it runs the DHCP server);
#   every other ip becomes a static DHCP reservation keyed by a MAC that
#   render.sh derives from the node name.
# - fsp extras:  cp=<control point>  port=<listen port>  model=<file in
#   roles/fsp/models/, or empty for none>
#
# Add another FSP box by appending a line and re-running ./up.sh.

NODES=(
  "rti-edge   edge  ${EDGE_IP}"
  "rti-so     so    ${NET_PREFIX}.11"
  "rti-fsp01  fsp   ${NET_PREFIX}.21   cp=cp1 port=5001 model=model.py"
  "rti-fsp02  fsp   ${NET_PREFIX}.22   cp=cp2 port=5005 model="
)
