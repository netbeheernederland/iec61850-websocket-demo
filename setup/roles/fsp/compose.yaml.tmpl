# rti-fsp (ACSI server / RTI-FSP) and its plugin dr-leds, one each per machine.
# Rendered per node by render.sh from nodes.env extras:
#   cp=${FSP_CP}  port=${FSP_PORT}  model=${FSP_MODEL}
# Host networking exposes ${FSP_PORT} on the VM IP.
name: ${NODE_NAME}

services:
  rti-fsp:
    image: rti-fsp:latest
    container_name: ${NODE_NAME}
    network_mode: host
    environment:
      PORT: "${FSP_PORT}"
      CP: "${FSP_CP}"
      PYTHONUNBUFFERED: "1"
      LOG_LEVEL: debug
      MODELPATH: "${FSP_MODELPATH}"
      # Its plugins (upstream decision 0029): dr-leds below. dr_panel needs a
      # Pi's devices, so it isn't on the VMs.
      PLUGINS: '{"host_url": "http://localhost:${FSP_PORT}", "plugins": [{"name": "dr_leds", "url": "http://localhost:8099/plugin"}]}'
    volumes:
      - /etc/rti/models:/models
      - /etc/rti/certs:/certs:ro
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:${FSP_PORT}/api/status"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

  # The sample plugin dr_leds (two simulated LEDs), one per node. On
  # 127.0.0.1 only: just this node's rti-fsp connects to it.
  dr-leds:
    image: dr-leds:latest
    container_name: dr-leds
    network_mode: host
    environment:
      HOST: 127.0.0.1
      PORT: "8099"
    restart: unless-stopped
