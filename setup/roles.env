# Fleet-wide configuration for the setup/ VM tooling.
# Sourced (after SETUP_DIR is exported) by every script via lib/common.sh.

# --- Ubuntu cloud image ---------------------------------------------------
UBUNTU_RELEASE="24.04"
UBUNTU_ARCH="amd64"
UBUNTU_IMAGE="ubuntu-${UBUNTU_RELEASE}-server-cloudimg-${UBUNTU_ARCH}.img"
UBUNTU_BASE_URL="https://cloud-images.ubuntu.com/releases/${UBUNTU_RELEASE}/release"

# --- libvirt ------------------------------------------------------------
LIBVIRT_NET="rti-demo-net"          # keep in sync with libvirt/rti-demo-net.xml
VM_USER="rti"                        # login user created by cloud-init
# Public key injected into every node. If empty, load_config() falls back to
# ~/.ssh/id_ed25519.pub then ~/.ssh/id_rsa.pub. Override with SSH_PUBKEY=...
SSH_PUBKEY="${SSH_PUBKEY:-}"

# --- demo network (the rti-edge node runs the authoritative dhcpd) ------
NET_PREFIX="192.168.150"            # /24
NET_NETMASK="255.255.255.0"
NET_GATEWAY="${NET_PREFIX}.1"       # libvirt virtual router + NAT + recursive DNS
EDGE_IP="${NET_PREFIX}.2"           # static; the edge node cannot DHCP itself
DHCP_RANGE_START="${NET_PREFIX}.100"
DHCP_RANGE_END="${NET_PREFIX}.199"
MDNS_DOMAIN="local"

# --- per-role machine sizing:  "vcpus ram_mb disk" ---------------------
declare -gA ROLE_SPEC=(
  [edge]="2 4096 12G"
  [so]="2 2048 8G"
  [fsp]="2 2048 8G"
)

# --- per-role docker image payload (tarball basenames, no .tar) --------
declare -gA ROLE_TARBALLS=(
  [edge]="rti-demo_bff-server rti-demo_rti-hmi"
  [so]="rti-demo_rti-so"
  [fsp]="rti-demo_rti-fsp"
)

# --- docker image refs to `docker save`, keyed by tarball basename ----
declare -gA IMAGE_REF=(
  [rti-demo_bff-server]="rti-demo_bff-server:latest"
  [rti-demo_rti-hmi]="rti-demo_rti-hmi:latest"
  [rti-demo_rti-so]="rti-demo_rti-so:latest"
  [rti-demo_rti-fsp]="rti-demo_rti-fsp:latest"
)

# Model files copied into every fsp node at /etc/rti/models (-> container /models)
FSP_MODELS_SRC="${SETUP_DIR}/roles/fsp/models"
